# Supabase Configuration
# Setup Instructions:
# 1. Go to supabase.com → create free account → new project
# 2. In Project Settings → API: copy Project URL and anon public key
# 3. Copy this file to .env.local and fill in values

NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Admin emails (comma-separated list of admin email addresses)
# Example: ADMIN_EMAILS=admin@example.com,manager@example.com
ADMIN_EMAILS=admin@example.com
